# Mount or expose this directory to the service. Requested projects must be inside it.
CODEX_PROJECT_ROOT=/projects

# Existing Redis, no password, database 0.
CODEX_REDIS_URL=redis://localhost:6379/0
CODEX_MAX_CONCURRENCY=2

CODEX_TIMEOUT_S=600
CODEX_API_KEY=

# Must equal AM_TOKEN_SECRET in the assets service so existing Bearer tokens remain valid.
CODEX_TOKEN_SECRET=replace-with-the-same-strong-secret

